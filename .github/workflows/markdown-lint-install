#!/usr/bin/env bash

echo "Installing markdown linter dependencies..."
# pinned to the last CommonJS releases, newer ones are ESM only and break require() in markdown-lint
npm install \
  prettier@2 \
  remark@13 remark-lint-no-dead-urls@1 remark-normalize-headings@2 \
  remark-parse@9 remark-stringify@9 remark-validate-links@10 vfile-reporter@6
